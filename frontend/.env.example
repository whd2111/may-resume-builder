# API Configuration (for local development)
VITE_API_URL=http://localhost:8000

# Page Count Service (Lambda function for exact 1-page validation)
# Local development uses the Lambda emulator
VITE_PAGE_COUNT_URL=http://localhost:9000

# For production, use:
# VITE_API_URL=https://api.yourdomain.com
# VITE_PAGE_COUNT_URL=https://your-lambda-url.amazonaws.com/page-count
