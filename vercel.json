{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd api && pip install uv && uv sync",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/app/main.py"
    }
  ],
  "functions": {
    "api/app/main.py": {
      "runtime": "python3.12",
      "maxDuration": 30
    }
  }
}
